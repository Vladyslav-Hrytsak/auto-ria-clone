{
  "name": "march-2024",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed:cars": "ts-node src/seed/seedCars.ts",
    "seed:admin": "ts-node src/seed/admin.seed.ts",
    "seed": "ts-node src/seed/seed.ts",
    "seed:badWords": "ts-node src/seed/profanity.seed.ts",
    "start:dev": "rimraf dist && tsc-watch --onSuccess \"npm run watch:server\"",
    "watch:server": "nodemon --exec ts-node src/index.ts",
    "start": "node ./dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "echo 'husky disabled'",
    "lint-staged": "lint-staged"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cron": "^4.4.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.3",
    "nodemailer": "^8.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^7.0.10",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.3.0",
    "joi": "^18.0.2",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript-eslint": "^8.54.0"
  }
